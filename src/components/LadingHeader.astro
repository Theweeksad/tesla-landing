---
import Logo from './Logo.astro'
import Global from '../../public/Global.astro'
import Support from '../../public/Support.astro'
import Account from '../../public/Account.astro'
---

<header
id="landing-header"
class="landing-section absolute py-3 px-10 flex items-center top-0 w-full justify-between z-40 text-white">
	<div class="flex flex-grow basis-0">
		<Logo />
	</div>

	<nav>
		<ul class="flex text-sm [&>li>a]:text-current [&>li>a]:font-medium [&>li>a]:inline-block} [&>li>a]:px-4 [&>li>a]:py-2">
			<li class="relative inline-block group">
				<a href="">Vehicles</a>
				<ul class="hidden group-hover:block top-0 absolute w-full h-[60vh] bg-white -z-4">
					<li>Model S</li>
					<li>Model 3</li>
					<li>Model X</li>
					<li>Model Y</li>
					<li>Cybertruck</li>
					<li>Help me choose</li>
				</ul>
			</li>
			<li class="relative inline-block group">
				<a href="#">Energy</a>
				<ul class="hidden group-hover:block">
					<li>Solar Panels</li>
					<li>Solar Roof</li>
					<li>Powerwall</li>
					<li>Megapack</li>
				</ul>
			</li>
			<li class="relative inline-block group">
				<a href="#">Charging</a>
				<ul class="hidden group-hover:block">
					<li>Charging</li>
					<li>Home Charging</li>
					<li>Supercharging</li>
				</ul>
			</li>
			<li><a href="#">Discover</a></li>
			<li class="relative inline-block group">
				<a href="#">Shop</a>
				<ul class="hidden group-hover:block">
					<li>Charging</li>
					<li>Vehicle Accesories</li>
					<li>Apparel</li>
					<li>Lifestyle</li>
				</ul>
			</li>
			<li><a href="#">We, Robot</a></li>
		</ul>
	</nav>

	<nav class="flex flex-grow basis-0 justify-end">
		<ul class="flex space-x-2 text-sm [&>li>a]:text-current [&>li>a]:font-medium [&>li>a]:inline-block} [&>li>a]:px-4 [&>li>a]:py-2">
			<li><a href="#"><Support/></a></li>
			<li><a href="#"><Global/></a></li>
			<li><a href="#"><Account/></a></li>
		</ul>
	</nav>
</header>

<script>
	const header = document.querySelector('#landing-header') as HTMLElement

	const observerOptions = {
		root: null,
		rootMargin: '0px',
		threshold: 0.90,
	}

	const observer = new IntersectionObserver(entries => {
		entries.forEach(entry => {
			const { isIntersecting } = entry
			if (isIntersecting) {
				const color = entry.target.getAttribute('data-header-color')
				header.style.color = color
			}
		})
	}, observerOptions)

	const sectionsElements = document.querySelectorAll(".landing-section")
	sectionsElements.forEach((section) => observer.observe(section))
</script>